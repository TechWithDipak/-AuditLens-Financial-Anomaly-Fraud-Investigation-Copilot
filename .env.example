# ==============================================================================
# AuditLens Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# Core Application Settings
APP_NAME=AuditLens
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Routing
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Persistence
DATABASE_URL=sqlite:///./backend/data/auditlens.db

# Storage Directories
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_FIXTURES_DIR=./data/fixtures
DATA_REFERENCE_DOCS_DIR=./data/reference_docs
ARTIFACTS_DIR=./artifacts

# Optional LLM & RAG Provider Settings
# Supported providers: offline (default, 100% free/local, no API key), openai, gemini
LLM_PROVIDER=offline
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=local

