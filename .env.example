# ==============================================================================
# AuditLens Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# DO NOT COMMIT SENSITIVE SECRETS OR REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Persistence & Database
# Default: Local SQLite database stored in backend directory
DATABASE_URL=sqlite:///./auditlens.db

# Machine Learning & Artifact Storage
MODEL_ARTIFACTS_DIR=./models
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLE_DIR=./data/sample

# Optional: LLM Provider Configuration
# Supported providers: none (local template fallback), gemini, openai, anthropic
LLM_PROVIDER=none
LLM_API_KEY=your_api_key_here_placeholder
LLM_MODEL_NAME=gemini-1.5-flash

# Vector Store / RAG Configuration
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_PROVIDER=local

